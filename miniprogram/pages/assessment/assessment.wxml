<van-toast id="van-toast" />

<view class="container">
  <view class="progress-bar">
    <view class="progress-label">已完成 {{doneCount}} / {{dimensions.length}}</view>
    <view class="progress-track">
      <view class="progress-fill" style="width: {{doneCount / dimensions.length * 100}}%"></view>
    </view>
  </view>

  <view class="child-info card" wx:if="{{childName}}">
    <text class="child-info-text">🌱 正在评估：{{childName}}，{{childAgeDisplay}}</text>
    <view class="child-info-edit" bindtap="editChildInfo">修改</view>
  </view>

  <view class="dim-grid">
    <view
      class="dim-card {{item.done ? 'dim-card--done' : ''}} {{currentDim === index ? 'dim-card--active' : ''}}"
      wx:for="{{dimensions}}"
      wx:key="key"
      bindtap="openPopup"
      data-index="{{index}}"
    >
      <view class="dim-check" wx:if="{{item.done}}">✅</view>
      <view class="dim-icon">{{item.icon}}</view>
      <view class="dim-name">{{item.name}}</view>
      <view class="dim-score" wx:if="{{item.done}}">
        <text wx:for="{{item.rating}}" wx:key="*this">⭐</text>
      </view>
      <view class="dim-score dim-score--pending" wx:else>待评估</view>
    </view>
  </view>

  <view class="bottom-btn">
    <van-button
      type="primary"
      block
      round
      disabled="{{doneCount < dimensions.length}}"
      bindclick="submitAssessment"
      loading="{{submitting}}"
    >
      {{doneCount < dimensions.length ? '完成全部评估后查看结果' : '查看评估结果 →'}}
    </van-button>
  </view>
</view>

<!-- 评估题目弹窗 -->
<van-popup
  show="{{showPopup}}"
  position="bottom"
  round
  bind:close="closePopup"
  custom-style="padding: 40rpx 32rpx 80rpx; max-height: 85vh; overflow-y: auto;"
>
  <view wx:if="{{currentDimData}}">
    <view class="popup-icon">{{currentDimData.icon}}</view>
    <view class="popup-title">{{currentDimData.name}}</view>

    <view class="question-block" wx:for="{{currentDimData.questions}}" wx:for-index="qIdx" wx:for-item="question" wx:key="qIdx">
      <view class="question-text">{{qIdx + 1}}. {{question.text}}</view>
      <view
        class="option-btn {{currentAnswers[qIdx] === opt.score ? 'option-btn--selected' : ''}}"
        wx:for="{{question.options}}"
        wx:for-item="opt"
        wx:key="score"
        bindtap="selectOption"
        data-qindex="{{qIdx}}"
        data-score="{{opt.score}}"
      >{{opt.label}}</view>
    </view>

    <van-button type="primary" block round custom-style="margin-top: 32rpx;" bindclick="confirmRating">
      确认
    </van-button>
  </view>
</van-popup>

<!-- 孩子信息弹窗（首次进入或点击修改时展示） -->
<van-popup
  show="{{showChildSetup}}"
  position="bottom"
  round
  custom-style="padding: 40rpx 32rpx 80rpx;"
>
  <view class="popup-title">孩子的基本信息</view>
  <van-field label="孩子姓名" value="{{form.name}}" bind:input="onFormChange" data-key="name" placeholder="请输入姓名" />
  <van-field label="年龄（岁）" value="{{form.ageYears}}" bind:input="onFormChange" data-key="ageYears" placeholder="如：5" type="number" />
  <van-field label="月数（可选）" value="{{form.ageMonths}}" bind:input="onFormChange" data-key="ageMonths" placeholder="如：9（5岁9个月填9）" type="number" />
  <van-field label="所在城市" value="{{form.hometown}}" bind:input="onFormChange" data-key="hometown" placeholder="如：浙江省杭州市" />
  <van-button type="primary" block round custom-style="margin-top: 32rpx;" bindclick="saveChildInfo">
    开始评估
  </van-button>
</van-popup>
